# From Supabase: Project Settings → API (or "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Daily "music in the metro" sync (server only; set in Vercel, never in browser code)
SUPABASE_SECRET_KEY=sb_secret_...
TICKETMASTER_API_KEY=   # optional
CRON_SECRET=any-long-random-string

# Artist links (optional; each one finds more links automatically)
# Spotify developer app: https://developer.spotify.com/dashboard → Create app → Client ID / Client secret
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Brave Search API key, for Instagram/Facebook/TikTok pages of smaller artists: https://api-dashboard.search.brave.com
BRAVE_SEARCH_API_KEY=
